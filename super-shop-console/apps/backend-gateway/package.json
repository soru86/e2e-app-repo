{
    "name": "@super-shop/backend-gateway",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "test": "vitest run --coverage",
        "lint": "eslint src --ext .ts",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:studio": "prisma studio",
        "prisma:seed": "prisma generate && tsx prisma/seed.ts"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@apollo/server": "^4.10.0",
        "@super-shop/shared-types": "workspace:*",
        "@prisma/client": "^5.15.0",
        "body-parser": "^1.20.2",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "graphql": "^16.9.0",
        "graphql-tag": "^2.12.6",
        "jose": "^5.2.2",
        "passport": "^0.7.0",
        "passport-openidconnect": "^0.1.1",
        "prom-client": "^15.1.2",
        "pino": "^9.0.0",
        "pino-http": "^9.0.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/body-parser": "^1.19.5",
        "@types/express": "^4.17.21",
        "@types/node": "^20.12.12",
        "@types/passport": "^1.0.14",
        "@types/passport-openidconnect": "^0.1.3",
        "eslint": "^8.57.0",
        "pino-pretty": "^11.2.2",
        "tsx": "^4.7.1",
        "typescript": "^5.4.5",
        "vitest": "^1.6.0",
        "prisma": "^5.15.0"
    }
}